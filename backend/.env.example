# 后端环境变量示例（复制为 .env 后填入真实值）
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# 允许的前端跨域来源，* 表示全部（生产建议改为你的域名）
CORS_ORIGIN=*

# PostgreSQL 连接串（替换为你的真实数据库地址）
DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/genie

# 管理后台 JWT 密钥（请改为随机长字符串）
JWT_SECRET=change-me-to-a-long-random-string

# 管理后台登录密码
ADMIN_PASSWORD=change-me

# 限流
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
